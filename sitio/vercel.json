{
  "functions": {
    "api/pagina.js": { "includeFiles": "index.html" }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/", "destination": "/api/pagina" },
    { "source": "/ligas", "destination": "/api/pagina" },
    { "source": "/:slug", "destination": "/api/pagina?slug=:slug" },
    { "source": "/:slug/:seccion", "destination": "/api/pagina?slug=:slug&seccion=:seccion" },
    { "source": "/:slug/:seccion/:extra", "destination": "/api/pagina?slug=:slug&seccion=:seccion&extra=:extra" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
